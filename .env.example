APP_ENV=local
APP_DEBUG=true

AUTH0_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-client-id
AUTH0_CLIENT_SECRET=your-client-secret
AUTH0_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Auth0 connection names configured in your tenant.
AUTH0_AD_CONNECTION=your-active-directory-connection
AUTH0_NON_AD_CONNECTION=Username-Password-Authentication

# Auth0 organization ID used for organization login.
AUTH0_ORGANIZATION=org_your-organization-id